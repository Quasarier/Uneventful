{
  "name": "@uneventful/api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma db execute --file prisma/grant-app-privileges.sql && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma db execute --file prisma/grant-app-privileges.sql && prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "lint": "eslint src test --max-warnings=0",
    "routes": "tsx scripts/list-routes.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.prisma.json",
    "test": "vitest run",
    "test:e2e:server": "tsx test/e2e/server.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-presigned-post": "^3.1169.0",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "bullmq": "^6.7.6",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.2",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^11.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/pg": "8.16.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
