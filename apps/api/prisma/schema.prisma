generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  engineType          = "client"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// PostgreSQL partial unique indexes for active soft-deleted records are defined
// in the migration; Prisma models them as ordinary indexes for query support.
enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN

  @@map("user_role")
}

enum ClubMembershipRole {
  MEMBER
  OFFICER
  PRESIDENT

  @@map("club_membership_role")
}

enum ClubMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT

  @@map("club_membership_status")
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED

  @@map("event_status")
}

enum ClubVerificationStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED

  @@map("club_verification_status")
}

enum VenueBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("venue_booking_status")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY

  @@map("recurrence_frequency")
}

enum RsvpStatus {
  GOING
  WAITLISTED
  CANCELLED
  CHECKED_IN

  @@map("rsvp_status")
}

enum TicketStatus {
  ISSUED
  REVOKED
  USED

  @@map("ticket_status")
}

enum CheckInMethod {
  QR
  MANUAL

  @@map("check_in_method")
}

enum NotificationType {
  EVENT_SUBMITTED
  EVENT_APPROVED
  EVENT_REJECTED
  EVENT_CANCELLED
  EVENT_UPDATED
  RSVP_CONFIRMED
  RSVP_CANCELLED
  WAITLISTED
  EVENT_REMINDER
  EVENT_REMINDER_24H
  EVENT_REMINDER_1H
  VENUE_BOOKING_UPDATED
  ACCOUNT_ROLE_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED

  @@map("notification_type")
}

enum ModerationTargetType {
  EVENT
  CLUB

  @@map("moderation_target_type")
}

enum ModerationReportReason {
  SPAM
  HARASSMENT
  UNSAFE
  MISLEADING
  OTHER

  @@map("moderation_report_reason")
}

enum ModerationReportStatus {
  OPEN
  RESOLVED

  @@map("moderation_report_status")
}

enum ModerationAction {
  DISMISS
  HIDE_EVENT
  CANCEL_EVENT
  SUSPEND_CLUB

  @@map("moderation_action")
}

enum AdminRoleGrantStatus {
  PENDING
  APPROVED
  EXPIRED

  @@map("admin_role_grant_status")
}

enum NotificationChannel {
  EMAIL
  PUSH

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  DEAD_LETTERED
  CANCELLED

  @@map("notification_delivery_status")
}

enum NotificationConsentAction {
  GRANTED
  OPTED_OUT

  @@map("notification_consent_action")
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  // Keep account identifiers globally reserved after soft deletion.
  email                    String                    @unique @db.VarChar(320)
  googleSubject            String                    @unique @map("google_subject") @db.VarChar(255)
  firstName                String                    @map("first_name") @db.VarChar(100)
  lastName                 String                    @map("last_name") @db.VarChar(100)
  avatarUrl                String?                   @map("avatar_url") @db.VarChar(2048)
  role                     UserRole                  @default(STUDENT)
  tokenVersion             Int                       @default(0) @map("token_version")
  isActive                 Boolean                   @default(true) @map("is_active")
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships              ClubMembership[]
  createdClubs             Club[]                    @relation("ClubCreator")
  createdEvents            Event[]                   @relation("EventCreator")
  approvedEvents           Event[]                   @relation("EventApprover")
  pendingEventImageUploads Event[]                   @relation("EventImageUploader")
  requestedBookings        VenueBooking[]            @relation("BookingRequester")
  reviewedBookings         VenueBooking[]            @relation("BookingReviewer")
  rsvps                    Rsvp[]
  checkedIns               CheckIn[]                 @relation("CheckInActor")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationConsents     NotificationConsent[]
  pushSubscriptions        PushSubscription[]
  followedClubs            ClubFollow[]
  recommendationPreference RecommendationPreference?
  recommendationConsents   RecommendationConsent[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  reportedContent          ModerationReport[]        @relation("ReportReporter")
  resolvedReports          ModerationReport[]        @relation("ReportResolver")
  requestedAdminGrants     AdminRoleGrantRequest[]   @relation("AdminGrantRequester")
  approvedAdminGrants      AdminRoleGrantRequest[]   @relation("AdminGrantApprover")
  targetedAdminGrants      AdminRoleGrantRequest[]   @relation("AdminGrantTarget")

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

model Club {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String                 @db.VarChar(160)
  slug               String                 @db.VarChar(180)
  description        String?                @db.Text
  verificationStatus ClubVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationReason String?                @map("verification_reason") @db.VarChar(1000)
  suspendedAt        DateTime?              @map("suspended_at") @db.Timestamptz(3)
  createdById        String                 @map("created_by_id") @db.Uuid
  deletedAt          DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          User                   @relation("ClubCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships        ClubMembership[]
  events             Event[]
  followers          ClubFollow[]

  @@index([createdById])
  @@index([deletedAt])
  @@map("clubs")
}

model ClubFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([userId, clubId])
  @@index([clubId, createdAt])
  @@index([userId, createdAt])
  @@map("club_follows")
}

model ClubMembership {
  id        String               @id @default(uuid()) @db.Uuid
  clubId    String               @map("club_id") @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  role      ClubMembershipRole   @default(MEMBER)
  status    ClubMembershipStatus @default(PENDING)
  joinedAt  DateTime?            @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime?            @map("left_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  club      Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, status])
  @@index([clubId, status, joinedAt])
  @@map("club_memberships")
}

model EventCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  events      Event[]

  @@index([deletedAt])
  @@map("event_categories")
}

model Venue {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @db.VarChar(160)
  slug          String              @db.VarChar(180)
  building      String?             @db.VarChar(160)
  room          String?             @db.VarChar(80)
  capacity      Int
  bufferMinutes Int                 @default(0) @map("buffer_minutes")
  isActive      Boolean             @default(true) @map("is_active")
  isAccessible  Boolean             @default(false) @map("is_accessible")
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  availability  VenueAvailability[]
  events        Event[]
  bookings      VenueBooking[]

  @@index([isActive, deletedAt])
  @@index([deletedAt])
  @@map("venues")
}

model VenueAvailability {
  venueId  String @map("venue_id") @db.Uuid
  weekday  Int
  opensAt  String @map("opens_at") @db.VarChar(5)
  closesAt String @map("closes_at") @db.VarChar(5)
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([venueId, weekday])
  @@map("venue_availability_hours")
}

model EventSeries {
  id              String              @id @default(uuid()) @db.Uuid
  frequency       RecurrenceFrequency
  interval        Int                 @map("recurrence_interval")
  occurrenceCount Int?                @map("occurrence_count")
  untilDate       DateTime?           @map("until_date") @db.Date
  exceptionDates  DateTime[]          @default([]) @map("exception_dates") @db.Date
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  events          Event[]

  @@map("event_series")
}

model Event {
  id                    String                @id @default(uuid()) @db.Uuid
  title                 String                @db.VarChar(200)
  slug                  String                @db.VarChar(220)
  description           String                @db.Text
  tags                  String[]              @default([])
  imageKey              String?               @map("image_key") @db.VarChar(512)
  pendingImageKey       String?               @map("pending_image_key") @db.VarChar(512)
  pendingImageExpiresAt DateTime?             @map("pending_image_expires_at") @db.Timestamptz(3)
  pendingImageOwnerId   String?               @map("pending_image_owner_id") @db.Uuid
  status                EventStatus           @default(DRAFT)
  startAt               DateTime              @map("start_at") @db.Timestamptz(3)
  endAt                 DateTime              @map("end_at") @db.Timestamptz(3)
  timeZone              String                @default("UTC") @map("time_zone") @db.VarChar(64)
  capacity              Int?
  expectedAttendance    Int?                  @map("expected_attendance")
  isPublic              Boolean               @default(true) @map("is_public")
  venueId               String?               @map("venue_id") @db.Uuid
  seriesId              String?               @map("series_id") @db.Uuid
  occurrenceIndex       Int?                  @map("occurrence_index")
  clubId                String                @map("club_id") @db.Uuid
  categoryId            String                @map("category_id") @db.Uuid
  createdById           String                @map("created_by_id") @db.Uuid
  approvedById          String?               @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?             @map("approved_at") @db.Timestamptz(3)
  rejectionReason       String?               @map("rejection_reason") @db.VarChar(1000)
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  club                  Club                  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  category              EventCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  venue                 Venue?                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  createdBy             User                  @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy            User?                 @relation("EventApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  pendingImageOwner     User?                 @relation("EventImageUploader", fields: [pendingImageOwnerId], references: [id], onDelete: Restrict)
  series                EventSeries?          @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  venueBookings         VenueBooking[]
  rsvps                 Rsvp[]
  notifications         Notification[]
  rsvpPromotionOutbox   RsvpPromotionOutbox[]

  @@unique([seriesId, occurrenceIndex])
  @@index([startAt])
  @@index([status, startAt])
  @@index([clubId, startAt])
  @@index([categoryId, startAt])
  @@index([createdById, createdAt])
  @@index([deletedAt])
  @@map("events")
}

model VenueBooking {
  id            String             @id @default(uuid()) @db.Uuid
  eventId       String             @map("event_id") @db.Uuid
  venueId       String             @map("venue_id") @db.Uuid
  requestedById String             @map("requested_by_id") @db.Uuid
  reviewedById  String?            @map("reviewed_by_id") @db.Uuid
  status        VenueBookingStatus @default(PENDING)
  startAt       DateTime           @map("start_at") @db.Timestamptz(3)
  endAt         DateTime           @map("end_at") @db.Timestamptz(3)
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  venue         Venue              @relation(fields: [venueId], references: [id], onDelete: Restrict)
  requestedBy   User               @relation("BookingRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?              @relation("BookingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([venueId, startAt, endAt])
  @@index([requestedById, createdAt])
  @@map("venue_bookings")
}

model Rsvp {
  id               String     @id @default(uuid()) @db.Uuid
  eventId          String     @map("event_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  status           RsvpStatus @default(GOING)
  waitlistPosition Int?       @map("waitlist_position")
  checkedInAt      DateTime?  @map("checked_in_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user             User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  ticket           Ticket?

  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([eventId, createdAt, status])
  @@index([userId, status, createdAt])
  @@map("rsvps")
}

model RsvpPromotionOutbox {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([dispatchedAt, createdAt])
  @@map("rsvp_promotion_outbox")
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  rsvpId       String       @unique @map("rsvp_id") @db.Uuid
  ticketIdHash String       @unique @map("ticket_id_hash") @db.Char(64)
  status       TicketStatus @default(ISSUED)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rsvp         Rsvp         @relation(fields: [rsvpId], references: [id], onDelete: Restrict)
  checkIn      CheckIn?

  @@index([status, expiresAt])
  @@map("tickets")
}

model CheckIn {
  id            String        @id @default(uuid()) @db.Uuid
  ticketId      String        @unique @map("ticket_id") @db.Uuid
  checkedInById String        @map("checked_in_by_id") @db.Uuid
  method        CheckInMethod
  checkedInAt   DateTime      @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  deviceId      String?       @map("device_id") @db.Uuid
  scannedAt     DateTime?     @map("scanned_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  checkedInBy   User          @relation("CheckInActor", fields: [checkedInById], references: [id], onDelete: Restrict)

  @@index([checkedInById, checkedInAt])
  @@map("check_ins")
}

model Notification {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  eventId     String?                @map("event_id") @db.Uuid
  dedupeKey   String?                @map("dedupe_key") @db.VarChar(180)
  type        NotificationType
  title       String                 @db.VarChar(160)
  body        String                 @db.VarChar(1000)
  scheduledAt DateTime               @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  readAt      DateTime?              @map("read_at") @db.Timestamptz(3)
  deliveredAt DateTime?              @map("delivered_at") @db.Timestamptz(3)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  event       Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  deliveries  NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([eventId, createdAt])
  @@index([scheduledAt, createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  availableAt    DateTime                   @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt       DateTime?                  @map("locked_at") @db.Timestamptz(3)
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, availableAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  type      NotificationType
  enabled   Boolean
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, channel, type])
  @@index([userId, channel])
  @@map("notification_preferences")
}

model NotificationConsent {
  id        String                    @id @default(uuid()) @db.Uuid
  userId    String                    @map("user_id") @db.Uuid
  channel   NotificationChannel
  type      NotificationType
  action    NotificationConsentAction
  source    String                    @db.VarChar(64)
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, channel, type, createdAt])
  @@map("notification_consents")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(128)
  auth      String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("push_subscriptions")
}

model RecommendationPreference {
  userId       String   @id @map("user_id") @db.Uuid
  personalized Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("recommendation_preferences")
}

model RecommendationConsent {
  id        String                    @id @default(uuid()) @db.Uuid
  userId    String                    @map("user_id") @db.Uuid
  action    NotificationConsentAction
  source    String                    @db.VarChar(64)
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("recommendation_consents")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(128)
  entityType   String   @map("entity_type") @db.VarChar(64)
  entityId     String?  @map("entity_id") @db.Uuid
  requestId    String?  @map("request_id") @db.VarChar(128)
  reason       String?  @db.VarChar(1000)
  beforeValues Json?    @map("before_values") @db.JsonB
  afterValues  Json?    @map("after_values") @db.JsonB
  actorIp      String?  @map("actor_ip") @db.VarChar(45)
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model ModerationReport {
  id               String                 @id @default(uuid()) @db.Uuid
  reporterId       String                 @map("reporter_id") @db.Uuid
  targetType       ModerationTargetType   @map("target_type")
  targetId         String                 @map("target_id") @db.Uuid
  openKey          String?                @unique @map("open_key") @db.VarChar(240)
  reason           ModerationReportReason
  note             String?                @db.VarChar(1000)
  status           ModerationReportStatus @default(OPEN)
  resolutionAction ModerationAction?      @map("resolution_action")
  resolutionReason String?                @map("resolution_reason") @db.VarChar(1000)
  resolvedById     String?                @map("resolved_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?              @map("resolved_at") @db.Timestamptz(3)
  reporter         User                   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy       User?                  @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt, id])
  @@index([targetType, targetId, status])
  @@map("moderation_reports")
}

model AdminRoleGrantRequest {
  id             String               @id @default(uuid()) @db.Uuid
  targetUserId   String               @map("target_user_id") @db.Uuid
  requestedById  String               @map("requested_by_id") @db.Uuid
  approvedById   String?              @map("approved_by_id") @db.Uuid
  status         AdminRoleGrantStatus @default(PENDING)
  reason         String               @db.VarChar(1000)
  approvalReason String?              @map("approval_reason") @db.VarChar(1000)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(3)
  target         User                 @relation("AdminGrantTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  requestedBy    User                 @relation("AdminGrantRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy     User?                @relation("AdminGrantApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([targetUserId, createdAt])
  @@map("admin_role_grant_requests")
}

model RefreshToken {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  familyId              String        @map("family_id") @db.Uuid
  tokenHash             String        @unique @map("token_hash") @db.Char(64)
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt             DateTime?     @map("revoked_at") @db.Timestamptz(3)
  tokenVersion          Int           @default(0) @map("token_version")
  googleAuthenticatedAt DateTime      @default(now()) @map("google_authenticated_at") @db.Timestamptz(3)
  replacedById          String?       @unique @map("replaced_by_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy            RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces              RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId, familyId, expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}
