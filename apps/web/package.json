{
  "name": "@uneventful/web",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests src",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ../../apps/api/openapi.yaml -o src/lib/api-schema.d.ts && prettier --write src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "next": "^15.2.4",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.10",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "10.6.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19"
  }
}
