# Copy this file to .env for local development. Replace the sample values locally.
POSTGRES_DB=campuspulse
POSTGRES_USER=campuspulse_local_user
POSTGRES_PASSWORD=replace-this-local-postgres-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-this-local-redis-password
REDIS_PORT=6379

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://campuspulse_local_user:replace-this-local-postgres-password@localhost:5432/campuspulse?schema=public
REDIS_URL=redis://:replace-this-local-redis-password@localhost:6379
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
UNIVERSITY_EMAIL_DOMAIN=example.edu
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
