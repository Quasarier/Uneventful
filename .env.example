# Copy this file to .env for local development. Replace the sample values locally.
POSTGRES_DB=uneventful
POSTGRES_USER=uneventful_local_user
POSTGRES_PASSWORD=replace-this-local-postgres-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-this-local-redis-password
REDIS_PORT=6379

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://uneventful_app:replace-this-local-application-password@localhost:5432/uneventful?schema=public
UNEVENTFUL_MIGRATOR_DB_PASSWORD=replace-this-local-migration-password
UNEVENTFUL_APP_DB_PASSWORD=replace-this-local-application-password
MIGRATION_DATABASE_URL=postgresql://uneventful_migrator:replace-this-local-migration-password@localhost:5432/uneventful?schema=public
SHADOW_DATABASE_URL=postgresql://uneventful_migrator:replace-this-local-migration-password@localhost:5432/uneventful_shadow?schema=public
REDIS_URL=redis://:replace-this-local-redis-password@localhost:6379
ANONYMOUS_RATE_LIMIT_PER_MINUTE=1200
GOOGLE_OAUTH_START_RATE_LIMIT_PER_15_MINUTES=1200
GOOGLE_OAUTH_CALLBACK_RATE_LIMIT_PER_15_MINUTES=1200
RSVP_RATE_LIMIT_PER_MINUTE=10
OBJECT_STORAGE_BUCKET=uneventful-local-assets
OBJECT_STORAGE_REGION=us-east-1
# Optional S3-compatible endpoint for local development (for example MinIO).
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
TRUST_PROXY_HOPS=0
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
UNIVERSITY_EMAIL_DOMAIN=example.edu
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_PRIVATE_KEY_B64=replace-with-base64-pkcs8-rsa-private-key
JWT_PUBLIC_KEY_B64=replace-with-base64-spki-rsa-public-key
JWT_KEY_ID=local-2026-01
# During key rotation, set both previous-key values together.
# JWT_PREVIOUS_KEY_ID=prior-key-id
# JWT_PREVIOUS_PUBLIC_KEY_B64=base64-encoded-previous-spki-public-key
JWT_ISSUER=https://api.example.edu
JWT_AUDIENCE=uneventful-api
REFRESH_TOKEN_TTL_DAYS=30
